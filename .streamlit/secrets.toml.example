# .streamlit/secrets.toml
# ========================
# Copy this file to .streamlit/secrets.toml and fill in your API keys.
# DO NOT commit secrets.toml to git — it is already in .gitignore.
#
# On Streamlit Community Cloud:
#   Go to App Settings → Secrets and paste the contents below.

GROQ_API_KEY = "gsk_your_groq_api_key_here"
